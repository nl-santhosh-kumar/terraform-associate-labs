[
  {{- range $index, $page := .Site.RegularPages -}}
    {{- /* ONLY index pages in the 'posts' folder, excluding everything else */ -}}
    {{- if eq .Section "posts" -}}
      {{- if $index -}}, {{ end -}}
      {
        "title": {{ .Title | jsonify }},
        "contents": {{ .Plain | jsonify }},
        "permalink": {{ .Permalink | jsonify }}
      }
    {{- end -}}
  {{- end -}}
]